# Plant Counselor — docker compose settings
# Copy to .env:  cp .env.example .env
# The defaults below run the full stack locally. Change the secrets before
# exposing the app anywhere other than your own machine.

# ── PostgreSQL ─────────────────────────────────────────────
POSTGRES_DB=plant_counselor
POSTGRES_USER=plant
POSTGRES_PASSWORD=change-me-db-password

# ── Backend (FastAPI) ──────────────────────────────────────
# Signs the session cookie (HS256). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me-to-a-long-random-string
# true when served over HTTPS
COOKIE_SECURE=false
# Comma-separated list of allowed browser origins
CORS_ALLOW_ORIGIN=http://localhost:3000
# Insert demo accounts and sample data on first start (demo/demo1234, admin/admin1234)
SEED_DEMO_DATA=true
# Host port for the API (http://localhost:8000/docs)
BACKEND_PORT=8000

# ── Frontend (Next.js) ─────────────────────────────────────
# API URL as seen from the browser (baked in at build time).
# If you change BACKEND_PORT, update this and rebuild: docker compose up --build
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
# Host port for the web app. If you change it, update CORS_ALLOW_ORIGIN too.
FRONTEND_PORT=3000

# No AI API key here: each user enters their own Gemini API key in
# Settings → AI. It is stored only in that browser's localStorage.
